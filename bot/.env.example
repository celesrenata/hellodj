# HelloDJ — Discord Bot Token
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Application (for web UI)
DISCORD_APPID=
DISCORD_PUBKEY=

# Bot owner / administrator Discord user id (for guild authorization policy)
# HelloDJ may only operate on a guild where at least one bot administrator (the
# owner here, or an OAuth-bound admin) is a member. Leave unset to rely on the
# OAuth-bound owner + admins from data/oauth.json instead.
BOT_OWNER_ID=

# Lavalink — required for audio playback via wavelink
# Public relay (no registration needed):
LAVALINK_HOST=losingtime.dpaste.org
LAVALINK_PORT=2124
LAVALINK_PASSWORD=SleepingOnTrains

# Or self-hosted Lavalink:
# LAVALINK_HOST=127.0.0.1
# LAVALINK_PORT=2333
# LAVALINK_PASSWORD=youshallnotpass

# ── Music providers (enable/disable each source) ──────────────────────────
# Values: true | false. Controls which sources are active in Lavalink.
PROVIDER_YOUTUBE=true
PROVIDER_YOUTUBEMUSIC=true
PROVIDER_SOUNDCLOUD=true
PROVIDER_SPOTIFY=true
PROVIDER_TIDAL=true

# ── youtube-source plugin OAuth (optional) ────────────────────────────────
# The youtube-source plugin replaces the deprecated built-in YouTube source and
# authenticates via an OAuth refresh token (NOT email/password). Leave disabled
# until you have a real refresh token.
YOUTUBE_OAUTH_ENABLED=false
YOUTUBE_OAUTH_REFRESH_TOKEN=

# Spotify — required for Spotify source support
# Uses global app credentials (not per-user OAuth); per-user OAuth is a later feature.
# Get credentials at https://developer.spotify.com
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── Tidal (optional) — required for /stream music-video playback ──────────
# TD_ENABLED documents intent to enable Tidal streaming (optional). The /stream
# command activates automatically when TD_CLIENT_ID / TD_CLIENT_SECRET are set.
# TD_CLIENT_ID / TD_CLIENT_SECRET are used by /stream to query the Tidal API
# (OAuth client-credentials) and fetch music-video URLs.
# Get credentials at https://developer.tidal.com
TD_ENABLED=false
TD_CLIENT_ID=
TD_CLIENT_SECRET=

# Genius — required for /lyrics command
# Get API key at https://genius.com/developers
# Legacy API key (token-based); kept for backward compatibility.
GENIUS_API_KEY=
# New Genius API client credentials (OAuth client application)
GENIUS_CLIENT_ID=
GENIUS_CLIENT_SECRET=
GENIUS_ACCESS_TOKEN=

# ── Voice activation ────────────────────────────────────────────────────
# Wake word ONNX model path (mounted at /app/models in docker-compose/kube).
WAKE_WORD_MODEL_PATH=/app/models/Hello_DJ.onnx
# Master switch for voice activation
VOICE_ENABLED=true

# ── STT engine selection ────────────────────────────────────────────────
# STT engine: local | openai | remote | bedrock  (default: local)
#   local   — faster-whisper in-process (STT_MODEL_SIZE controls model size)
#   openai  — OpenAI-compatible /v1/audio/transcriptions endpoint
#   remote  — alias of "openai" (backward compatibility)
#   bedrock — AWS Bedrock / Amazon Transcribe (file-based via S3 + boto3)
STT_ENGINE=local
# STT model size for faster-whisper (base | small | medium | large-v3)
STT_MODEL_SIZE=base
# OpenAI-compatible STT endpoint (only used when STT_ENGINE=openai|remote)
STT_WHISPER_ENDPOINT=
# STT API key (only used when STT_ENGINE=openai|remote)
STT_API_KEY=
# Backward-compatible alias for the STT endpoint
STT_URL=

# ── AWS credentials (used by STT_ENGINE=bedrock and TTS_ENGINE=bedrock) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Optional: assume an IAM role instead of env credentials (EC2/EKS instance role)
AWS_ROLE_ARN=
# S3 bucket for Bedrock STT (Amazon Transcribe requires audio in S3)
BEDROCK_S3_BUCKET=
# Optional: transcription language code (default en-US)
STT_BEDROCK_LANGUAGE=en-US
# Optional: max seconds to wait for a transcription job (default 60)
STT_BEDROCK_TIMEOUT=60

# ── TTS engine selection ────────────────────────────────────────────────
# TTS engine: kokoro | speaches | openai | bedrock  (default: kokoro)
#   kokoro   — local KPipeline, or remote if TTS_KOKORO_ENDPOINT is set
#   speaches — speaches HTTP server (OpenAI-compatible /v1/audio/speech)
#   openai   — OpenAI-compatible /v1/audio/speech endpoint
#   bedrock  — AWS Polly (neural voice, via boto3)
TTS_ENGINE=kokoro
# TTS voice for kokoro (see https://huggingface.co/hexgrad/Kokoro)
TTS_VOICE=af_heart
# Remote kokoro / OpenAI-compatible speech endpoint
TTS_KOKORO_ENDPOINT=
# TTS API key (only used when TTS_ENGINE=openai)
TTS_API_KEY=
# speaches HTTP server URL (only used when TTS_ENGINE=speaches)
TTS_SPEACHES_ENDPOINT=
# Backward-compatible aliases
KOKORO_URL=
SPEACHES_URL=
# AWS Polly voice ID (only used when TTS_ENGINE=bedrock)
# See https://docs.aws.amazon.com/polly/latest/dg/voicelist.html
POLLY_VOICE_ID=Joanna
# Polly output format: mp3 | pcm  (mp3 is decoded to PCM via ffmpeg)
POLLY_OUTPUT_FORMAT=mp3

# ── LLM (general voice queries) ─────────────────────────────────────────
# OpenAI-compatible endpoint + key
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ── Metrics ────────────────────────────────────────────────────────────
# How many days of AI usage records to retain (default 30). Records older
# than this window are pruned during rollup. The web UI dashboard and the
# /metrics slash command read the same data/metrics.json file.
METRICS_RETENTION_DAYS=30

# ── MCP / general-query API keys (optional) ─────────────────────────────
# News: https://newsapi.org
NEWS_API_KEY=
# Stocks: https://finnhub.io (free tier) — read as STOCKS_API_KEY by the bot
STOCKS_API_KEY=

# ── Stem separation (OPTIONAL, heavy AI) ────────────────────────────────
# /filter stems isolate drums|bass|melody needs a source-separation model
# (demucs/spleeter/onnx) that is heavy (torch/onnx, multi-GB) and NOT installed
# by default. Set STEM_MODEL to a model name or path to enable detection.
# NOTE: the streaming architecture cannot yet inject a separated stem into
# Lavalink playback; /filter stems isolate vocals uses the karaoke filter
# (instrumental) regardless. Leave unset to use only the karaoke fallback.
STEM_MODEL=

# ── Debug / Diagnostics ─────────────────────────────────────────────────
# Master debug switch (1=enabled, 0=disabled)
HELLODJ_DEBUG=1
# Comma-separated list of debug modules to enable (or * for all):
#   player, bot, tidal, music, voice_cmd, session, radio, stream, filters,
#   autoplay, audio_pipeline, wakeword, stt, tts, intent, query, source
HELLODJ_DEBUG_MODULES=*
# Minimum debug level (DEBUG, INFO, WARNING)
HELLODJ_DEBUG_LEVEL=DEBUG
# Ultra-verbose function entry/exit tracing (1=on, 0=off)
HELLODJ_DEBUG_TRACE=0
# Voice connection diagnostics (1=on, 0=off)
HELLODJ_VOICE_DEBUG=1
