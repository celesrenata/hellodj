# HelloDJ — Discord Bot Token
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Application (for web UI)
DISCORD_APPID=
DISCORD_PUBKEY=

# Lavalink — required for audio playback via wavelink
# Public relay (no registration needed):
LAVALINK_HOST=losingtime.dpaste.org
LAVALINK_PORT=2124
LAVALINK_PASSWORD=SleepingOnTrains

# Or self-hosted Lavalink:
# LAVALINK_HOST=127.0.0.1
# LAVALINK_PORT=2333
# LAVALINK_PASSWORD=youshallnotpass

# ── Music providers (enable/disable each source) ──────────────────────────
# Values: true | false. Controls which sources are active in Lavalink.
PROVIDER_YOUTUBE=true
PROVIDER_YOUTUBEMUSIC=true
PROVIDER_SOUNDCLOUD=true
PROVIDER_SPOTIFY=true
PROVIDER_TIDAL=true

# ── youtube-source plugin OAuth (optional) ────────────────────────────────
# The youtube-source plugin replaces the deprecated built-in YouTube source and
# authenticates via an OAuth refresh token (NOT email/password). Leave disabled
# until you have a real refresh token.
YOUTUBE_OAUTH_ENABLED=false
YOUTUBE_OAUTH_REFRESH_TOKEN=

# Spotify — required for Spotify source support
# Uses global app credentials (not per-user OAuth); per-user OAuth is a later feature.
# Get credentials at https://developer.spotify.com
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Genius — required for /lyrics command
# Get API key at https://genius.com/developers
# Legacy API key (token-based); kept for backward compatibility.
GENIUS_API_KEY=
# New Genius API client credentials (OAuth client application)
GENIUS_CLIENT_ID=
GENIUS_CLIENT_SECRET=
GENIUS_ACCESS_TOKEN=

# ── Voice activation ────────────────────────────────────────────────────
# Wake word ONNX model path (mounted at /app/models in docker-compose/kube).
WAKE_WORD_MODEL_PATH=/app/models/Hello_DJ.onnx
# STT model size for faster-whisper (base | small | medium | large-v3)
STT_MODEL_SIZE=base
# TTS engine (kokoro | speaches)
TTS_ENGINE=kokoro
# TTS voice for kokoro (see https://huggingface.co/hexgrad/Kokoro)
TTS_VOICE=af_heart
# speaches HTTP server URL (only used when TTS_ENGINE=speaches)
SPEACHES_URL=
# Master switch for voice activation
VOICE_ENABLED=true

# ── LLM (general voice queries) ─────────────────────────────────────────
# OpenAI-compatible endpoint + key
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ── MCP / general-query API keys (optional) ─────────────────────────────
# News: https://newsapi.org
NEWS_API_KEY=
# Stocks: https://finnhub.io (free tier) — read as STOCKS_API_KEY by the bot
STOCKS_API_KEY=
