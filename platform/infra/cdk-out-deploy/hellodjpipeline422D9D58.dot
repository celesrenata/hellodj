digraph G {
  # Arrows represent an "unlocks" relationship (opposite of dependency). So chosen
  # because the layout looks more natural that way.
  # To represent subgraph dependencies, subgraphs are represented by BEGIN/END nodes.
  # To render: `dot -Tsvg hellodjpipeline422D9D58.dot > graph.svg`, open in a browser.
  node [shape="box"];
"BEGIN Build" [shape="cds", style="filled", fillcolor="#b7deff"];
"END Build" [shape="cds", style="filled", fillcolor="#b7deff"];
"Build.synth";
"Source.hellodj" -> "Build.synth";
"Build.build-discord-bot-core" -> "Build.synth";
"Build.build-playback-orchestrator" -> "Build.synth";
"Build.build-lavalink" -> "Build.synth";
"Build.build-tidal-stream" -> "Build.synth";
"Build.build-spotify-stream" -> "Build.synth";
"Build.build-yt-cipher" -> "Build.synth";
"Build.build-potoken-server" -> "Build.synth";
"Build.build-activity-backend" -> "Build.synth";
"Build.build-hls-transcode" -> "Build.synth";
"Build.build-voice-pipeline" -> "Build.synth";
"Build.build-web-ui" -> "Build.synth";
"Build.build-config-renderer" -> "Build.synth";
"Build.build-discord-bot-core";
"Build.build-playback-orchestrator";
"Build.build-lavalink";
"Build.build-tidal-stream";
"Build.build-spotify-stream";
"Build.build-yt-cipher";
"Build.build-potoken-server";
"Build.build-activity-backend";
"Build.build-hls-transcode";
"Build.build-voice-pipeline";
"Build.build-web-ui";
"Build.build-config-renderer";
"BEGIN Build" -> "Build.build-activity-backend";
"BEGIN Build" -> "Build.build-config-renderer";
"BEGIN Build" -> "Build.build-discord-bot-core";
"BEGIN Build" -> "Build.build-hls-transcode";
"BEGIN Build" -> "Build.build-lavalink";
"BEGIN Build" -> "Build.build-playback-orchestrator";
"BEGIN Build" -> "Build.build-potoken-server";
"BEGIN Build" -> "Build.build-spotify-stream";
"BEGIN Build" -> "Build.build-tidal-stream";
"BEGIN Build" -> "Build.build-voice-pipeline";
"BEGIN Build" -> "Build.build-web-ui";
"BEGIN Build" -> "Build.build-yt-cipher";
"Build.synth" -> "END Build";
"BEGIN UpdatePipeline" [shape="cds", style="filled", fillcolor="#b7deff"];
"END UpdatePipeline" [shape="cds", style="filled", fillcolor="#b7deff"];
"UpdatePipeline.SelfMutate";
"Build.synth" -> "UpdatePipeline.SelfMutate";
"BEGIN UpdatePipeline" -> "UpdatePipeline.SelfMutate";
"UpdatePipeline.SelfMutate" -> "END UpdatePipeline";
"BEGIN hellodj-beta-stage" [shape="cds", style="filled", fillcolor="#b7deff"];
"END hellodj-beta-stage" [shape="cds", style="filled", fillcolor="#b7deff"];
"UpdatePipeline.SelfMutate" -> "BEGIN hellodj-beta-stage";
"BEGIN hellodj-beta-stage.hellodj-workloads-beta" [shape="cds", style="filled", fillcolor="#b7deff"];
"END hellodj-beta-stage.hellodj-workloads-beta" [shape="cds", style="filled", fillcolor="#b7deff"];
"hellodj-beta-stage.hellodj-workloads-beta.Deploy";
"hellodj-beta-stage.hellodj-workloads-beta.Prepare" -> "hellodj-beta-stage.hellodj-workloads-beta.Deploy";
"hellodj-beta-stage.hellodj-workloads-beta.Prepare";
"Build.synth" -> "hellodj-beta-stage.hellodj-workloads-beta.Prepare";
