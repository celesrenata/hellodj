"hellodj-staging-stage.hellodj-workloads-staging.Deploy" -> "END hellodj-staging-stage.hellodj-workloads-staging";
"BEGIN hellodj-staging-stage" -> "BEGIN hellodj-staging-stage.hellodj-workloads-staging";
"END hellodj-staging-stage.hellodj-workloads-staging" -> "END hellodj-staging-stage";
"BEGIN hellodj-production-stage" [shape="cds", style="filled", fillcolor="#b7deff"];
"END hellodj-production-stage" [shape="cds", style="filled", fillcolor="#b7deff"];
"UpdatePipeline.SelfMutate" -> "BEGIN hellodj-production-stage";
"END hellodj-staging-stage" -> "BEGIN hellodj-production-stage";
"BEGIN hellodj-production-stage.hellodj-workloads-production" [shape="cds", style="filled", fillcolor="#b7deff"];
"END hellodj-production-stage.hellodj-workloads-production" [shape="cds", style="filled", fillcolor="#b7deff"];
"hellodj-production-stage.hellodj-workloads-production.Deploy";
"hellodj-production-stage.hellodj-workloads-production.Prepare" -> "hellodj-production-stage.hellodj-workloads-production.Deploy";
"hellodj-production-stage.hellodj-workloads-production.Prepare";
"Build.synth" -> "hellodj-production-stage.hellodj-workloads-production.Prepare";
"BEGIN hellodj-production-stage.hellodj-workloads-production" -> "hellodj-production-stage.hellodj-workloads-production.Prepare";
"hellodj-production-stage.hellodj-workloads-production.Deploy" -> "END hellodj-production-stage.hellodj-workloads-production";
"BEGIN hellodj-production-stage" -> "BEGIN hellodj-production-stage.hellodj-workloads-production";
"END hellodj-production-stage.hellodj-workloads-production" -> "END hellodj-production-stage";
"BEGIN Source" [shape="cds", style="filled", fillcolor="#b7deff"];
"END Source" [shape="cds", style="filled", fillcolor="#b7deff"];
"Source.hellodj";
"BEGIN Source" -> "Source.hellodj";
"Source.hellodj" -> "END Source";
}