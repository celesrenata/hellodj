"END hellodj-beta-stage.hellodj-workloads-beta" -> "END hellodj-beta-stage";
"BEGIN hellodj-staging-stage" [shape="cds", style="filled", fillcolor="#b7deff"];
"END hellodj-staging-stage" [shape="cds", style="filled", fillcolor="#b7deff"];
"UpdatePipeline.SelfMutate" -> "BEGIN hellodj-staging-stage";
"END hellodj-beta-stage" -> "BEGIN hellodj-staging-stage";
"BEGIN hellodj-staging-stage.hellodj-workloads-staging" [shape="cds", style="filled", fillcolor="#b7deff"];
"END hellodj-staging-stage.hellodj-workloads-staging" [shape="cds", style="filled", fillcolor="#b7deff"];
"hellodj-staging-stage.hellodj-workloads-staging.Deploy";
"hellodj-staging-stage.hellodj-workloads-staging.Prepare" -> "hellodj-staging-stage.hellodj-workloads-staging.Deploy";
