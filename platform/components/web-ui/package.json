{
  "name": "hellodj-web-ui",
  "version": "0.1.0",
  "private": true,
  "description": "HelloDJ web-ui — Tailwind CSS v4 build for the Flask + HTMX + Alpine admin UI.",
  "scripts": {
    "build:css": "tailwindcss -i static/css/app.css -o static/css/app.build.css --minify",
    "watch:css": "tailwindcss -i static/css/app.css -o static/css/app.build.css --watch",
    "fetch:vendor": "curl -fsSL https://unpkg.com/htmx.org@2/dist/htmx.min.js -o static/js/htmx.min.js && curl -fsSL https://unpkg.com/alpinejs@3/dist/cdn.min.js -o static/js/alpine.min.js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0"
  }
}
