# Python
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/

# Environment
.env
bot/.env

# Bot runtime data
bot/playlists.json
bot/playlists.json.tmp
bot/sessions.json
bot/sessions.json.tmp

# Training artifacts
training/output/
training/*.onnx
training/*.tflite

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker
.docker/

# Large build artifacts
kube/lavalink/Lavalink.jar

# Sticker assets now live in S3 (served via CDN, HELLODJ_STICKER_CDN_URL). The
# repo tracks only the build scripts, the curated manifest.json (tiny JSON the
# bot reads at startup to build its catalog index), and the license/attribution
# notes — NOT the multi-GB upstream download cache or the raw webp bytes (those
# are uploaded to S3 out-of-band by the sticker sync).
stickers/stickers-upstream/
stickers/hellodj-stickers/assets/
stickers/hellodj-stickers/legacy-zips/
stickers/**/*.zip

# Bot sticker assets (generated by stickers/prepare-hellodj-stickers.py); the
# image bytes are served from S3, so keep them out of git. The manifest is
# tracked from stickers/hellodj-stickers/manifest.json instead.
bot/stickers/assets/
bot/stickers/*.zip

# Transient secret staging (bot-app pool) — never commit
.bot-app-pool.tmp.json
.pool-cur.tmp.json
.pool-new.tmp.json

# Local bot-app pool token material — never commit
/tokens
/bot-app-pool.json

# Secrets Manager backups — live token material, never commit
/secrets-manager-backup*.json
